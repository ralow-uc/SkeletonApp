<?xml version='1.0' encoding='utf-8'?>
<widget id="com.lowcubes.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>LowCubes</name>
  <description>App para practicar algoritmos de Rubik</description>
  <author email="tucorreo@ejemplo.com" href="https://lowcubes.com">
    Raúl Low
  </author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-navigation href="*" />

  <!-- Android -->
  <platform name="android">
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="34" />
    <icon density="mdpi" src="resources/android/icon/drawable-mdpi-icon.png" />
  </platform>

  <!-- iOS -->
  <platform name="ios">
    <preference name="deployment-target" value="13.0" />
    <icon height="180" width="180" src="resources/ios/icon/icon.png" />
  </platform>

  <preference name="ScrollEnabled" value="false" />
  <preference name="android-windowSoftInputMode" value="adjustResize" />
  <preference name="BackupWebStorage" value="none" />
  <preference name="SplashScreen" value="screen" />
  <preference name="FadeSplashScreen" value="false" />
  <preference name="FadeSplashScreenDuration" value="300" />
  <preference name="ShowSplashScreenSpinner" value="false" />
</widget>